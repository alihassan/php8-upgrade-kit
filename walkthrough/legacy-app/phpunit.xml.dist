<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" colors="true" beStrictAboutOutputDuringTests="true">
    <php>
        <!-- Same error level as the test web server (see tests/Http.php). -->
        <ini name="error_reporting" value="22527"/>
    </php>
    <testsuites>
        <testsuite name="Invoicer">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
