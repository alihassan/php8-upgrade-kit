{
    "name": "php8-upgrade-kit/upgrade-tools",
    "description": "Static analysis and refactoring tools for the walkthrough. Kept apart from the app's own dependencies.",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpcompatibility/php-compatibility": "10.0.0-alpha2@alpha",
        "phpstan/phpstan": "^2.3",
        "rector/rector": "^2.8"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
